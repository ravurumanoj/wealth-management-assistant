flowchart TD

    %% 1. User Query
    USER["Wealth Advisor"]
    QUERY["User Query"]

    %% 2. Intent Router
    ROUTER{"Intent Router"}

    %% 3. Agents / Clarify / Direct
    AGENT1["Portfolio Insights Agent"]
    AGENT2["Relationship Intelligence Agent"]
    CLARIFY["Clarification"]
    DIRECT["Direct Response"]

    %% 4. Tools
    T1["Portfolio Summary"]
    T2["Portfolio Metrics"]
    T3["Market Data"]
    T4["Engagement History"]
    T5["Vector Search"]
    T6["Web Search"]

    %% 5. LLM Call and Response
    LLM["LLM Call"]
    RESPONSE["Streaming Response"]

    %% Hierarchy: Top to Bottom
    USER --> QUERY
    QUERY --> ROUTER

    ROUTER -->|"Portfolio"| AGENT1
    ROUTER -->|"Relationship"| AGENT2
    ROUTER -->|"Ambiguous"| CLARIFY
    ROUTER -->|"General"| DIRECT

    AGENT1 --> T1
    AGENT1 --> T2
    AGENT1 --> T3
    AGENT2 --> T4
    AGENT2 --> T5
    AGENT2 --> T6

    T1 --> LLM
    T2 --> LLM
    T3 --> LLM
    T4 --> LLM
    T5 --> LLM
    T6 --> LLM
    CLARIFY --> LLM
    DIRECT --> LLM

    LLM --> RESPONSE
    RESPONSE --> USER

