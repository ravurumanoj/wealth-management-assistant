# Wealth Management Assistant — Environment Configuration
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# ============================================
# Application Settings
# ============================================
APP_NAME="Wealth Management Assistant"
HOST="0.0.0.0"
PORT=8000
DEBUG=True
RELOAD=True

# ============================================
# Google Gemini API  (DISABLED — Unique AI is active)
# Uncomment to switch back to Gemini
# ============================================
# GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_MODEL=gemini-2.0-flash-lite
# GEMINI_TEMPERATURE=0.7
# GEMINI_MAX_TOKENS=8192

# Embedding model (DISABLED — long-term memory embeddings disabled)
# EMBEDDING_MODEL=models/gemini-embedding-001

# ============================================
# Unique AI LLM  (active — set these in your .env)
# ============================================
UNIQUE_API_BASE_URL=https://your-unique-ai-endpoint/v1
UNIQUE_MODEL_NAME=your_model_name_here
UNIQUE_APP_ID=your_app_id_here
UNIQUE_APP_KEY=your_app_key_here
UNIQUE_COMPANY_ID=your_company_id_here
UNIQUE_USER_ID=your_user_id_here

# ============================================
# SSL Configuration (for corporate networks)
# ============================================
# Option 1 (recommended): point to your corporate CA certificate file
# SSL_CA_CERT_PATH=C:/path/to/corporate-ca.pem

# Option 2 (quick test only — not for production): disable SSL verification
# SSL_VERIFY=False

# ============================================
# PostgreSQL Memory DB  (active — replaces MySQL)
# Run the DDL: data/memory/wealth_memory_mysql_ddl.sql (adapt types for pg)
# or let SQLAlchemy create tables automatically on first startup.
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DATABASE=wealth_memory
# Optional: override with a full SQLAlchemy URL
# MEMORY_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/wealth_memory

# MYSQL_DISABLED — kept for reference
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password_here
# MYSQL_DATABASE=wealth_memory
DB_ECHO=False

# ============================================
# MCP — CRM Server  (optional)
# Leave MCP_CRM_SERVER_URL blank to disable MCP; the CRM agent will skip tool calling.
# ============================================
MCP_ENABLED=True
MCP_CRM_SERVER_URL=
MCP_TRANSPORT=streamable_http
MCP_TIMEOUT=15
MCP_MAX_TOOL_ITERATIONS=5

# ============================================
# Memory & Storage paths
# ============================================
MEMORY_STORAGE_PATH="data/memory/sessions.json"
LONG_TERM_MEMORY_PATH="data/memory/long_term_memory.json"

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
ENABLE_FILE_LOGGING=True
LOG_FILE=logs/app.log

# ============================================
# Agent Configuration
# ============================================
DEFAULT_AGENT_TIMEOUT=600
MAX_AGENT_ITERATIONS=5
